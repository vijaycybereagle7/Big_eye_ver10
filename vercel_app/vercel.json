{"version": 2, "builds": [{"src": "app/main.py", "use": "@vercel/python"}], "routes": [{"src": "/(.*)", "dest": "app/main.py"}], "env": {"SUPABASE_URL": "@supabase_url", "SUPABASE_ANON_KEY": "@supabase_anon_key", "SECRET_KEY": "@secret_key", "DEBUG": "false"}, "functions": {"app/main.py": {"runtime": "python3.11", "maxDuration": 10}}, "regions": ["iad1"], "rewrites": [{"source": "/api/(.*)", "destination": "/api/$1"}]}