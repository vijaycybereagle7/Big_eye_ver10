# Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Cybersecurity Validation API"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api/v1"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY="your-very-secure-secret-key-change-in-production"

# API Key Authentication - Add your API keys here
# You can override these with environment variables or database entries
VALID_API_KEYS='{
  "default": {"key": "default-api-key-123", "name": "Default API Key", "admin": false},
  "admin": {"key": "admin-api-key-456", "name": "Admin API Key", "admin": true}
}'

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ADMIN_REQUESTS=1000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
POSTGRESQL_URL="postgresql://user:password@localhost:5432/cybersec_db"

# MongoDB Database  
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="cybersec_db"

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_TTL=3600

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# VirusTotal API Key (https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# AbuseIPDB API Key (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY="your-abuseipdb-api-key"

# Shodan API Key (https://account.shodan.io/register)
SHODAN_API_KEY="your-shodan-api-key"

# GreyNoise API Key (https://www.greynoise.io/)
GREYNOISE_API_KEY="your-greynoise-api-key"

# AlienVault OTX API Key (https://otx.alienvault.com/)
OTX_API_KEY="your-otx-api-key"

# SecurityTrails API Key (https://securitytrails.com/)
SECURITYTRAILS_API_KEY="your-securitytrails-api-key"

# URLhaus API (free, no key required)
# URLHAUS_API_KEY=""

# =============================================================================
# EMAIL VALIDATION SETTINGS
# =============================================================================
# Email validation service API key (optional)
EMAIL_VALIDATION_API_KEY="your-email-validation-api-key"

# SMTP Settings (for email delivery testing)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL="INFO"
LOG_FILE="api/logs/app.log"

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# =============================================================================
# CACHE SETTINGS
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=86400

# =============================================================================
# VALIDATION RULES
# =============================================================================
MAX_BULK_VALIDATION_ITEMS=1000
MIN_DOMAIN_LENGTH=3
MAX_DOMAIN_LENGTH=253
MIN_IP_LENGTH=7
MAX_IP_LENGTH=45

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Set these for production deployment
# WORKERS=4
# WORKER_CONNECTIONS=1000
# MAX_REQUESTS=10000
# MAX_REQUESTS_JITTER=1000
# KEEPALIVE=5

# =============================================================================
# MONITORING & METRICS (Optional)
# =============================================================================
# PROMETHEUS_METRICS_ENABLED=true
# GRAFANA_API_KEY="your-grafana-api-key"

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
# ALERT_EMAIL="admin@yourcompany.com"
# SMTP_USE_TLS=true
# SMTP_SSL=false

# =============================================================================
# DEVELOPMENT SETTINGS (Only for development)
# =============================================================================
# Enable these only in development
# DEBUG_TOOLBAR=true
# SQLALCHEMY_ECHO=false
# CORS_ALLOW_ALL_ORIGINS=false