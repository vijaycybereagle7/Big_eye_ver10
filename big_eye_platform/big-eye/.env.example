# Public browser configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Set true for production environments that must require Supabase Auth.
# Leave false/empty for Vercel preview testing with safe offline analysis.
VITE_REQUIRE_AUTH=false
VITE_ALLOW_OFFLINE_FALLBACK=true
