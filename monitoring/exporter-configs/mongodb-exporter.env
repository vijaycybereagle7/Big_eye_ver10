# MongoDB Exporter Configuration

# MongoDB connection URI
MONGODB_URI="mongodb://username:password@localhost:27017/admin"

# Basic authentication
BASIC_AUTH_USERNAME="monitoring"
BASIC_AUTH_PASSWORD="monitoring_password"

# Web configuration
WEB_LISTEN_ADDRESS=":9216"
WEB_TELEMETRY_PATH="/metrics"

# Timeout configuration
CONNECT_TIMEOUT=5s
SOCKET_TIMEOUT=5s

# TLS configuration
TLS_DISABLED=true
TLS_SKIP_VERIFY=true

# Metrics collection
ENABLE_COLLECTIONDN_METRICS=true
ENABLE_CONNECTIONS_METRICS=true
ENABLE_DISKLOCATIONS_METRICS=true
ENABLE_INDEX_COUNTERS_METRICS=true
ENABLE_OPLOG_METRICS=true
ENABLE_REPLICA_SET_METRICS=true
ENABLE_TOPOLOGY_METRICS=true
ENABLE_SERVER_STATUS_METRICS=true

# High-resolution metrics
HIGH_RESOLUTION_METRICS=true

# Feature flags
ENABLE_CUSTOM_DURATION_METRICS=true
ENABLE_SHARD_CLUSTER_METRICS=true