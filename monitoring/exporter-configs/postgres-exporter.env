# PostgreSQL Exporter Configuration
DATA_SOURCE_NAME="postgresql://username:password@localhost:5432/database?sslmode=disable"

# PostgreSQL connection settings
PG_EXPORTER_EXTEND_QUERY_PATH="/etc/postgres_exporter/queries.yaml"
PG_EXPORTER_DISABLE_DEFAULT_METRICS=false
PG_EXPORTER_DISABLE_SETTINGS_METRICS=false

# Custom queries for enhanced monitoring
PG_EXPORTER_CUSTOM_QUERY_PATH="/etc/postgres_exporter/custom_queries.yaml"

# Metric collection settings
PG_EXPORTER_CONNECT_TIMEOUT=10s
PG_EXPORTER_QUERY_TIMEOUT=5s

# Logging
PG_EXPORTER_LOG_LEVEL=info